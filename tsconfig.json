{
	"compilerOptions": {
		"target": "ES6",
		"module": "ESNext",
		"moduleResolution": "Node",
		"outDir": "dist",
		"declaration": true,
		"declarationDir": "dist/types",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"strict": true,
        "strictNullChecks": false, // Note: I use optional changing and heavily rely on `null` and `undefined` values in the codebase. Please do not set this to true unless you want the compiler to throw a fucking temper tantrum every time you try to access a property of an object that may or may not be null or undefined. I have better things to do than to deal with that nonsense.
		"noImplicitAny": true,
		"paths": {
			"@ParsingHVTEC/*": ["./src/parsers/hvtec/*"],
			"@ParsingVTEC/*": ["./src/parsers/vtec/*"],
			"@ParsingUGC/*": ["./src/parsers/ugc/*"],
			"@ParsingText/*": ["./src/parsers/text/*"],
			"@Database/*": ["./src/components/database/*"],
			"@Audio/*": ["./src/components/audio/*"],
			"@AudioComponents/*": ["./src/components/audio/components/*"],
			"@Image/*": ["./src/components/images/*"],
			"@ImageModules/*": ["./src/components/images/modules/*"],
			"@ImageComponents/*": ["./src/components/images/components/*"],
			"@Stanza/*": ["./src/components/stanza/*"],
			"@Utilities/*": ["./src/components/utilities/*"],
			"@XMPP/*": ["./src/components/xmpp/*"],
			"@Manager/*": ["./src/manager/*"],
			"@Tasks/*": ["./src/tasks/*"],
			"@Events/*": ["./src/events/*"],
			"@Enums/*": ["./src/enums/*"],
			"@Core/*": ["./src/core/*"],
			"@Building/*": ["./src/building/*"],
			"Types/*": ["./src/types/*"],
			"StaticTypes/*": ["./src/static/*"],
			"@Bootstrap": ["./src/bootstrap.ts"],
		}
	},
	"include": ["src"]
}